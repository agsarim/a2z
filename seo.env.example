# Set on the hosting provider BEFORE building; use the preferred HTTPS origin.
# No path, query string, or credentials. Example: https://www.your-domain.com
SITE_URL=

# Set true on staging/preview environments. Vercel previews are detected automatically.
SEO_NOINDEX=false

# Optional verification tokens (the content value, not the entire HTML tag).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
